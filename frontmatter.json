					"required": true
				},
				{
					"title": "Tags",
					"name": "tags",
					"type": "tags"
				},
				{
					"title": "Image",
					"name": "image",
					"type": "image"
				},
				{
					"title": "Repo",
					"name": "repo",
					"type": "string",
					"required": true
				},
				{
					"title": "Demo",
					"name": "demo",
					"type": "string"
				},
				{
					"title": "Needs translation",
					"name": "needs_translation",
					"type": "boolean",
					"default": false
				},
				{
					"title": "Draft",
					"name": "draft",
					"type": "boolean"
				}
			]
		},
		{
			"name": "weekly",
			"pageBundle": false,
