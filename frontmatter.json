{
	"$schema": "https://frontmatter.codes/frontmatter.schema.json",
	"frontMatter.taxonomy.contentTypes": [
		{
			"name": "post",
			"pageBundle": false,
			"previewPath": null,
			"fields": [
				{
					"title": "Title",
					"name": "title",
					"type": "string",
					"required": true
				},
				{
					"title": "Date",
					"name": "date",
					"type": "datetime",
					"default": "{{now}}",
					"required": true
				},
				{
					"title": "Tags",
					"name": "tags",
					"type": "tags"
				},
				{
					"title": "Image",
					"name": "image",
					"type": "image"
				},
				{
					"title": "Link",
					"name": "link",
					"type": "string"
				},
				{
					"title": "Needs translation",
					"name": "needs_translation",
					"type": "boolean",
					"default": false
				},
				{
					"title": "Draft",
					"name": "draft",
					"type": "boolean"
				}
			]
		},
		{
			"name": "article",
			"pageBundle": false,
			"previewPath": null,
			"fields": [
				{
					"title": "Title",
					"name": "title",
					"type": "string",
					"required": true
				},
				{
					"title": "Date",
					"name": "date",
					"type": "datetime",
					"default": "{{now}}",
					"required": true
				},
				{
					"title": "Tags",
					"name": "tags",
					"type": "tags"
				},
				{
					"title": "Image",
					"name": "image",
					"type": "image"
				},
				{
					"title": "Needs translation",
					"name": "needs_translation",
					"type": "boolean",
					"default": false
				},
				{
					"title": "Draft",
					"name": "draft",
					"type": "boolean"
				}
			]
		},
		{
			"name": "project",
			"pageBundle": false,
			"previewPath": null,
			"fields": [
				{
					"title": "Title",
					"name": "title",
					"type": "string",
					"required": true
				},
				{
					"title": "Subtitle",
					"name": "subtitle",
					"type": "string"
				},
				{
