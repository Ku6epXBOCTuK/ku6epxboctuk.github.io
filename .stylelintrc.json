{
	"extends": ["stylelint-config-recommended", "stylelint-config-html/svelte"],
	"rules": {
		"selector-pseudo-class-no-unknown": [
			true,
			{
				"ignorePseudoClasses": ["global"]
			}
		]
	},
	"ignoreFiles": [
		".github/**/*",
		".svelte-kit/**/*",
		"build/**/*",
		"packages/*/build/**/*",
		"packages/*/.svelte-kit/**/*",
		"coverage/**/*",
		"dist/**/*",
		"node_modules/**/*",
		"refs/**/*"
	]
}
