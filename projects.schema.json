{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Projects manifest",
	"type": "object",
	"required": ["projects"],
	"additionalProperties": false,
	"properties": {
		"projects": {
			"type": "array",
			"items": { "$ref": "#/definitions/project" }
		}
	},
	"definitions": {
		"project": {
			"type": "object",
			"required": ["repo"],
			"additionalProperties": false,
			"properties": {
				"repo": {
					"type": "string",
					"pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+"
				},
				"path": {
					"type": "string",
					"minLength": 1
				},
				"frozen": {
					"type": "boolean",
					"const": true
				},
				"slug": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*$"
				},
				"title": {
					"type": "string"
				},
				"homepage": {
					"type": "string",
					"format": "uri"
				},
				"image": {
					"type": "string"
				},
				"subtitle": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": { "type": "string" }
				}
			}
		}
	}
}
